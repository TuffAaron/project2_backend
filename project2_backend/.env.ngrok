# ngrok tunnel environment variables
# Replace abc123 with your actual ngrok subdomain
APP_BASE_URL=https://abc123.ngrok.io
SERVER_ADDRESS=0.0.0.0

# GitHub OAuth2 - UPDATE redirect URI to: https://abc123.ngrok.io/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth2 - UPDATE redirect URI to: https://abc123.ngrok.io/login/oauth2/code/google  
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Microsoft OAuth2 - UPDATE redirect URI to: https://abc123.ngrok.io/login/oauth2/code/microsoft
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_TENANT_ID=common

# Discord OAuth2 - UPDATE redirect URI to: https://abc123.ngrok.io/login/oauth2/code/discord
DISCORD_CLIENT_ID=your_discord_client_id_here  
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Database
H2_CONSOLE_ENABLED=true

# Logging
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
WEB_LOG_LEVEL=INFO