# Production environment variables (Heroku/Railway/etc.)
APP_BASE_URL=https://your-app-name.herokuapp.com
SERVER_ADDRESS=0.0.0.0

# GitHub OAuth2 - UPDATE redirect URI to: https://your-app-name.herokuapp.com/login/oauth2/code/github
GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret

# Google OAuth2 - UPDATE redirect URI to: https://your-app-name.herokuapp.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret

# Microsoft OAuth2 (optional)
MICROSOFT_CLIENT_ID=your_production_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_production_microsoft_client_secret
MICROSOFT_TENANT_ID=common

# Discord OAuth2 (optional)  
DISCORD_CLIENT_ID=your_production_discord_client_id
DISCORD_CLIENT_SECRET=your_production_discord_client_secret

# Database (Heroku provides JAWSDB_URL automatically)
H2_CONSOLE_ENABLED=false

# Logging (less verbose in production)
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
WEB_LOG_LEVEL=WARN