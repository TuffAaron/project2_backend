## ---- AUTH0 (Universal Provider) ----

# Update OAuth redirect URIs in provider consoles to:AUTH0_DOMAIN=your-auth0-domain.auth0.com

# https://your-app.herokuapp.com/login/oauth2/code/githubAUTH0_CLIENT_ID=your_auth0_client_id_here

# https://your-app.herokuapp.com/login/oauth2/code/googleAUTH0_CLIENT_SECRET=your_auth0_client_secret_here

AUTH0_AUDIENCE=your_auth0_audience_here

# =================================
# JWT CONFIGURATION
# =================================
JWT_SECRET=your_super_secret_jwt_signing_key_here_make_it_long_and_random
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# =================================
# SESSION CONFIGURATION
# =================================
SESSION_TIMEOUT=1800
SESSION_SECRET=your_session_secret_key_here

# =================================
# CORS CONFIGURATION
# =================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# =================================
# SECURITY SETTINGS
# =================================
BCRYPT_ROUNDS=12
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600000

# =================================
# LOGGING CONFIGURATION
# =================================
LOG_LEVEL=INFO
LOG_LEVEL_OAUTH=DEBUG
LOG_LEVEL_SECURITY=DEBUG

# =================================
# EMAIL CONFIGURATION (if needed)
# =================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=noreply@yourapp.com

# =================================
# REDIS CONFIGURATION (for session storage)
# =================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# =================================
# PRODUCTION OVERRIDES
# =================================
# Uncomment and set these for production deployment
# SPRING_PROFILES_ACTIVE=prod
# APP_BASE_URL=https://your-production-domain.com
# JWT_SECRET=your_production_jwt_secret_here
# SESSION_SECRET=your_production_session_secret_here

# =================================
# DEVELOPMENT SETTINGS
# =================================
# Enable SQL logging for development
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false
H2_CONSOLE_ENABLED=true
H2_CONSOLE_PATH=/h2-console

# =================================
# NOTES FOR SETUP:
# =================================
# 1. Copy this file to .env.local for local development
# 2. Replace all placeholder values with actual credentials
# 3. Add .env.local to your .gitignore file
# 4. For each OAuth provider you want to use:
#    - Register your app with the provider
#    - Get client ID and secret
#    - Configure redirect URIs
#    - Update the corresponding variables above
# 
# Common redirect URI pattern: http://localhost:8080/login/oauth2/code/{provider}
# Production redirect URI: https://yourdomain.com/login/oauth2/code/{provider}