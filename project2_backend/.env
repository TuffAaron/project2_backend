DATABASE_DIALECT=org.hibernate.dialect.H2DialectPORT=8080# APPLICATION SETTINGS# APPLICATION SETTINGS



# Hibernate DDL auto mode (update, create, create-drop, validate, none)

DDL_AUTO=update

