HIKARI_MIN_IDLE=2JAWSDB_USERNAME=sa

HIKARI_CONNECTION_TIMEOUT=20000

HIKARI_IDLE_TIMEOUT=300000JAWSDB_PASSWORD=# =================================APP_BASE_URL=http://localhost:8080

HIKARI_MAX_LIFETIME=1200000

HIKARI_LEAK_DETECTION=60000



