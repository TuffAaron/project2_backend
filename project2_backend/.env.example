# =================================
# JWT CONFIGURATION
# =================================
JWT_SECRET=your_super_secret_jwt_signing_key_here
JWT_EXPIRATION=86400000

# =================================
# CORS CONFIGURATION
# =================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true