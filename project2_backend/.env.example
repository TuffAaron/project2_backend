# =================================
# PROJECT2_BACKEND - OAuth2 Environment Configuration (EXAMPLE)
# =================================
# Copy this file to .env.local and fill in your actual values
# This example file is safe to commit to version control

# =================================
# APPLICATION SETTINGS
# =================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# =================================
# DATABASE CONFIGURATION
# =================================
JAWSDB_URL=jdbc:h2:file:./data/nba_games_db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
JAWSDB_DRIVER=org.h2.Driver
JAWSDB_USERNAME=sa
JAWSDB_PASSWORD=
JAWSDB_DIALECT=org.hibernate.dialect.H2Dialect

# =================================
# OAUTH2 PROVIDERS CONFIGURATION
# =================================

